# Server
PORT=4000
NODE_ENV=production

# CORS - comma separated list of allowed origins (your parent app / dashboards)
CORS_ORIGINS=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/parental_monitoring

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# WebRTC / signaling session token
SESSION_TOKEN_SECRET=change_this_too_long_random_string
SESSION_TOKEN_EXPIRES_IN=10m

# Optional: public STUN/TURN servers for the apps to consume via /api/config
STUN_SERVERS=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-server:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
