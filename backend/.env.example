PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/seftly_development
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-different-random-secret-at-least-32-characters
SESSION_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TOKEN_EXPIRES_IN=10m
STUN_SERVERS=stun:stun.l.google.com:19302
# Supply private TURN_URL, TURN_USERNAME and TURN_CREDENTIAL in the runtime environment.
# PARENT_CHILD_API_TOKEN is a server-to-server credential, never a browser credential.
TRUST_PROXY_HOPS=0
# Retention is disabled by default. Apply only after backup and explicit operator policy.
RETENTION_LOCATION_DAYS=0
RETENTION_BROWSING_DAYS=0
RETENTION_USAGE_DAYS=0
