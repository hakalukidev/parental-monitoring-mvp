{
  "name": "parental-monitoring-backend",
  "version": "1.3.0",
  "description": "Seftly family safety REST, policy and authorized media signaling backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext .ts",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.0",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
